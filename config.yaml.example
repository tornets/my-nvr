# NVR 配置文件示例
# 复制此文件为 config.yaml 并根据您的需求修改

# ============================================
# 店铺配置
# ============================================
shop:
  id: 1  # 店铺ID

# ============================================
# 流配置列表
# ============================================
streams:
  # 摄像头 1
  - id: camera1
    name: 前门摄像头  # 流名称（可选，用于文件名显示，默认为空则使用 id）
    url: rtsp://admin:password@192.168.1.100:554/stream1

    # 自动重连配置
    auto_reconnect: true            # 是否自动重连（默认: true）
    reconnect_interval_seconds: 5   # 重连间隔，秒（默认: 5）
    max_reconnect_attempts: -1      # 最大重连次数，-1表示无限重连（默认: -1）
    timeout_seconds: 30             # 流超时时间，秒（默认: 30）

    # 可选的额外参数（传递给 FFmpeg）
    extra_params:
      # rtsp_transport: tcp          # 强制使用 TCP 传输

    # ============================================
    # 智能录制配置（RK3588 平台，按流独立配置）
    # ============================================
    smart_recording:
      enabled: false                     # 是否启用智能录制

      # 预缓存时长（秒）：在 IDLE 状态下缓存最近 N 秒的视频帧
      # 当检测到玩家时，从最近的关键帧开始写入预缓存的帧
      prebuffer_duration_seconds: 5

      # 分段时长（秒）：智能录制的每个视频段的最小时长
      segment_duration_seconds: 60

      # 最小录制时长（秒）：检测到玩家后至少录制 N 秒才停止
      min_recording_duration: 10

      # 玩家消失后延迟停止秒数：玩家消失后延迟 N 秒再停止录制
      # 若延迟期间玩家重新出现，则继续录制
      post_recording_delay_seconds: 5

      # RKNN 检测配置
      rknn:
        enabled: false                 # 是否启用 RKNN 检测
        model_path: "models/yolo11.rknn"  # RKNN 模型文件路径

        # 检测模式：keyframe | sampled | realtime
        # - keyframe: 只检测 I 帧，按 detection_interval_keyframes 跳帧（默认）
        # - sampled:  按 PTS 时间间隔检查（所有帧统一按间隔，关键帧始终解码用于预缓存）
        # - realtime: 每一帧都检测（含非关键帧）
        detection_mode: keyframe

        # keyframe 模式：检测间隔（关键帧数）
        # 每 N 个关键帧检测一次，例如 30 表示每 30 个关键帧检测一次
        detection_interval_keyframes: 30

        # sampled 模式：检测间隔（秒）
        # 每 N 秒检测一次（所有帧统一按间隔，关键帧始终解码用于预缓存）
        detection_interval_seconds: 2.0

        # 玩家类别 ID（YOLO11 模型）
        player_class_id: 0               # 玩家类别 ID

        # NPC 类别 ID（YOLO11 模型）
        npc_class_id: 1                  # NPC 类别 ID

        # 检测置信度阈值（0.0 - 1.0）
        confidence_threshold: 0.5         # 检测置信度阈值，低于此值的结果会被过滤

        # 零拷贝开关：使用 RGA + DMA-BUF 零拷贝管道
        # 禁用时回退到 CPU 预处理（性能较低）
        zero_copy_enabled: true

      # 调试图像导出配置
      dump_detect:
        enable: false                    # 是否导出调试图像
        filter: all                      # 导出过滤: all | has_detection | no_detection

  # 摄像头 2（示例）
  # - id: camera2
  #   name: 后门摄像头
  #   url: rtsp://192.168.1.101:554/stream1
  #   auto_reconnect: true
  #   reconnect_interval_seconds: 10
  #   max_reconnect_attempts: 3     # 最多重连3次，超过后停止
  #   timeout_seconds: 60

# ============================================
# 录制配置
# ============================================
record:
  # 输出目录（所有流的录制文件将保存在此目录下）
  output_dir: "C:/NVR/recordings"

  # 临时目录（录制过程中的文件）
  temp_dir: "C:/NVR/recordings/.temp"

  # 录制分段时长（秒）
  segment_duration_seconds: 600  # 10分钟

  # 文件名模板
  # 支持的变量:
  #   {stream_id}       - 流ID（如：camera1）
  #   {stream_name}     - 流名称（如配置中的 name 字段，为空则使用 stream_id）
  #   {shop_id}         - 店铺ID
  #   {start_date}      - 录制开始日期（如：2026-02-03）
  #   {start_time}      - 录制开始时间（如：143000）
  #   {start_datetime}  - 录制开始时间（如：20260203_143000）
  #   {end_time}        - 结束时间（HHMMSS 格式）
  #   {end_datetime}    - 结束时间（yyyymmdd_HHMMSS 格式）
  #   {segment_index}   - 分段序号（该流的第N个分段）
  #   {duration}        - 该段时长（HHMMSS 格式）
  #   {duration_seconds} - 该段时长（秒）
  #   {width}           - 视频宽度
  #   {height}          - 视频高度
  #   {fps}             - 帧率
  #   {codec}           - 编解码器名称
  #
  # 支持的视频格式（通过文件扩展名指定）：
  #   .mp4  - MP4 格式，视频支持 H.264/H.265，音频支持 AAC/MP3/Opus
  #   .mkv  - MKV 格式，几乎支持所有音视频编码
  #   .avi  - AVI 格式，视频支持 H.264/MPEG4，音频支持 MP3/AC3
  #   .mov  - MOV 格式，视频支持 H.264/H.265，音频支持 AAC/MP3
  #   .flv  - FLV 格式，视频支持 H.264/FLV1，音频支持 AAC/MP3
  #   .webm - WebM 格式，视频支持 VP8/VP9/AV1，音频支持 Opus/Vorbis
  #   .ts   - MPEG-TS 格式，视频支持 H.264，音频支持 AAC/MP3/AC3
  #
  # 编码策略：
  #   - 视频：优先直接 copy，不转码。如果不兼容则报错并停止该流录制
  #   - 音频：优先直接 copy，不转码。如果不兼容则自动转码为格式最佳编码
  #
  filename_template: "{shop_id}_{stream_name}_{start_datetime}_{end_time}.mp4"
  # 示例输出: 1_前门摄像头_20260208_174244_175251.mp4
  #
  # 使用 MKV 格式（兼容性最好）：
  # filename_template: "{shop_id}_{stream_name}_{start_datetime}.mkv"
  #
  # 使用 WebM 格式（适合 Web 播放）：
  # filename_template: "{shop_id}_{stream_name}_{start_datetime}.webm"

  # 是否启用音频录制
  enable_audio: true  # true: 启用音频, false: 仅视频

  # 录制时间段配置（可选）
  # 启用后，仅在指定时间段内录制，非录制时间段仍会继续上传
  schedule:
    enabled: false                    # 是否启用调度（默认: false）
    check_interval_seconds: 60        # 调度检查间隔（秒），最小10秒，最大300秒（默认: 60）
    time_ranges:                      # 录制时间段列表
      # 时间段格式：HH:MM，支持跨午夜（如 22:00-02:00 表示晚上10点到凌晨2点）
      - start: "12:00"                # 示例：中午12点到凌晨2点
        end: "02:00"
      # - start: "08:00"              # 可以配置多个时间段
      #   end: "10:00"

  # ============================================
  # 两阶段录制配置（智能录制 + 事件提取）
  # ============================================
  # 两阶段架构：实时录制全部视频 → raw 目录
  #             事件提取有人片段 → filter 目录
  raw_subdir: "raw"                        # 实时录制子目录（默认: raw）
  filter_subdir: "filter"                  # 事件提取子目录（默认: filter）
  enable_extraction: true                  # 是否启用事件提取（默认: true）
  extraction_scan_interval_seconds: 1      # 提取扫描间隔，秒（默认: 1）
  delete_raw_after_extraction: false       # 提取完成后是否删除原始视频（默认: false）

  # 最小玩家片段时长（秒）：小于此时长的片段将被过滤
  min_player_segment_duration: 5           # 默认: 5

  # 玩家片段合并最大间隔（秒）：两个有人片段之间的间隔小于此值则合并
  player_segment_merge_gap: 5              # 默认: 5

# ============================================
# 日志配置
# ============================================
log_level: "info"  # 可选值: trace, debug, info, warn, error, critical

# ============================================
# 视频上传配置（可选）
# ============================================
upload:
  enabled: false                      # 是否启用上传功能
  url: "https://your-server.com/api/upload"  # 上传服务器 URL
  timeout_seconds: 10                 # 上传超时时间（秒）
  max_retries: 3                      # 上传失败最大重试次数, -1 无限重试
  retry_delay_seconds: 5              # 重试间隔（秒）

  # 多线程上传配置
  threads: 4                          # 并发上传线程数（1-32，默认: 1）
                                       # 建议：4-8 个线程适用于大多数场景
                                       # 网络带宽充足时可以增加到 16-32

  # 上传进度持久化配置
  persist_progress: true               # 是否保存上传进度到磁盘
  progress_file: "./upload_progress.json"  # 进度文件路径
                                       # 进度信息包括：已上传文件、失败文件、重试次数等
                                       # 重启后会自动恢复，避免重复上传

  # 上传目录过滤：raw（全部视频）| filter（仅有人片段）| all（全部）
  upload_subdir: "filter"              # 默认: filter

# ============================================
# 自动清理配置
# ============================================
autoclean:
  enabled: true
  max_age_hours: 168  # 7天
  max_disk_usage_gb: 100
  check_interval_seconds: 3600  # 1小时

# ============================================
# NPU 检测池配置（RK3588 平台）
# ============================================
# 仅在启用智能录制时生效，控制全局 NPU 推理池的并发度
detection_pool:
  workers: 3                 # NPU worker 数量（对应 NPU 核心数，RK3588 最大 3）
  queue_size: 64             # 最大排队任务数（建议 >= 流数量 × 2）
