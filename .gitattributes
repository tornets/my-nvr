# Batch files - Windows CRLF and GBK encoding
*.bat text eol=crlf working-tree-encoding=GBK

# Shell scripts - Unix LF and UTF-8
*.sh text eol=lf

# C/C++ source files - UTF-8
*.c text diff=cpp
*.cpp text diff=cpp
*.h text diff=cpp
*.hpp text diff=cpp

# CMake files
*.txt text
CMakeLists.txt text

# YAML, JSON, Markdown - UTF-8
*.yaml text
*.yml text
*.json text
*.md text

# Inno Setup scripts
*.iss text eol=crlf

# Visual Studio files
*.sln text eol=crlf
*.vcxproj text eol=crlf

# Executables and binaries
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.a binary
*.lib binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
