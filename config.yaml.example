# NVR 配置文件示例
# 复制此文件为 config.yaml 并根据您的需求修改

# ============================================
# 店铺配置
# ============================================
shop:
  id: 1  # 店铺ID

# ============================================
# 流配置列表
# ============================================
streams:
  # 摄像头 1
  - id: camera1
    url: rtsp://admin:password@192.168.1.100:554/stream1
    # 可选参数
    params:
      timeout: 30           # 连接超时（秒）
      reconnect: auto       # 自动重连

  # 摄像头 2（示例）
  # - id: camera2
  #   url: rtsp://192.168.1.101:554/stream1
  #   params:
  #     timeout: 60

# ============================================
# 录制配置
# ============================================
record:
  # 输出目录（所有流的录制文件将保存在此目录下）
  output_dir: "C:/NVR/recordings"

  # 临时目录（录制过程中的文件）
  temp_dir: "C:/NVR/recordings/.temp"

  # 录制分段时长（秒）
  segment_duration_seconds: 600  # 10分钟

  # 文件名模板
  # 支持的变量:
  #   {stream_id}       - 流ID（如：camera1）
  #   {start_date}      - 录制开始日期（如：20260203_143000）
  #   {start_time}      - 录制开始时间（如：143000）
  #   {start_datetime}  - 录制开始时间（如：20260203_143000）
  #   {end_time}        - 结束时间（HHMMSS 格式）
  #   {end_datetime}    - 结束时间（yyyymmdd_HHMMSS 格式）
  #   {segment_index}   - 分段序号（该流的第N个分段）
  #   {duration}        - 该段时长（秒）
  filename_template: "{stream_id}_{start_datetime}_seg{segment_index}_{duration}.mp4"
  # 示例输出: camera1_2026-02-03_14-30-00_seg1_600.mp4

  # 是否启用音频录制
  enable_audio: true  # true: 启用音频, false: 仅视频

# ============================================
# 日志配置
# ============================================
log_level: "info"  # 可选值: trace, debug, info, warn, error, critical

# ============================================
# 视频上传配置（可选）
# ============================================
upload:
  enabled: false
  url: "https://your-server.com/api/upload"
  timeout_seconds: 300
  max_retries: 3
  retry_delay_seconds: 5

# ============================================
# 自动清理配置
# ============================================
autoclean:
  enabled: true
  max_age_hours: 168  # 7天
  max_disk_usage_gb: 100
  check_interval_seconds: 3600  # 1小时
